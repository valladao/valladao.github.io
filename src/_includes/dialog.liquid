{%- comment -%} Before release, remove these | include in project {%- endcomment -%}
{%- comment %} theme-check-disable UndefinedObject {%- endcomment -%}
{% for dialog in dialogs %}
  <dialog class="project-dialog" id="dialog-{{ dialog.id }}">
    <div class="tech-border">
      <div class="tech-border-internal">
        <h2>{{ dialog.label }}</h2>
        <h3>{{ dialog.jobPosition }}</h3>
        {% for section in dialog.content %}
          {% if section.type == "p" %}
            <p>{{ section.data }}</p>
          {% endif %}
          {% if section.type == "list" %}
            <ul>
              {% for item in section.data %}
                <li>{{ item }}</li>
              {% endfor %}
            </ul>
          {% endif %}
        {% endfor %}
      </div>
      <div class="label">
          <form method="dialog">
            <button class="close"><h3>X</h3></button>
          </form>
      </div>
    </div>
  </dialog>
{% endfor %}
