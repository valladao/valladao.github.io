{% assign about = about[0] %}
<section id="about">
  <h2>About</h2>
  {% for section in about.summary %}
    {% if section.type == "p" %}
      <p>{{ section.data }}</p>
    {% endif %}
  {% endfor %}
  <div class="link">
    <span>+ </span>
    <a href="#" data-dialog-id="about">Know more</a>
  </div>
</section>
